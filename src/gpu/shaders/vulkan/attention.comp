#version 450

// Fused Multi-Head Attention
// For each head: scores = Q_h @ K_h^T * scale, softmax, output = scores @ V_h
// Q, K, V, O are all [seq_len, hidden_dim] with strided per-head access
//
// Dispatch: (num_heads, seq_len, 1) workgroups
// WorkGroupID.x = head index, WorkGroupID.y = output row

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer BufQ { float q[]; };
layout(set = 0, binding = 1) readonly buffer BufK { float k[]; };
layout(set = 0, binding = 2) readonly buffer BufV { float v[]; };
layout(set = 0, binding = 3) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform Params {
    uint seq_len;
    uint num_heads;
    uint head_dim;
    float scale;  // 1.0 / sqrt(head_dim)
};

shared float scores[512];  // max seq_len
shared float sdata[256];   // for parallel reductions

void main() {
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;

    uint hidden = num_heads * head_dim;
    uint head_offset = head * head_dim;

    // Phase 1: Compute attention scores
    // scores[j] = dot(Q[row, head_offset:+head_dim], K[j, head_offset:+head_dim]) * scale
    for (uint j = tid; j < seq_len; j += 256) {
        float dp = 0.0;
        for (uint d = 0; d < head_dim; d++) {
            dp += q[row * hidden + head_offset + d] * k[j * hidden + head_offset + d];
        }
        scores[j] = dp * scale;
    }
    barrier();

    // Phase 2: Stable softmax over scores[0..seq_len-1]
    // Find max
    float local_max = -1e30;
    for (uint j = tid; j < seq_len; j += 256) {
        local_max = max(local_max, scores[j]);
    }
    sdata[tid] = local_max;
    barrier();

    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) sdata[tid] = max(sdata[tid], sdata[tid + s]);
        barrier();
    }
    float max_val = sdata[0];
    barrier();

    // Exp and sum
    float local_sum = 0.0;
    for (uint j = tid; j < seq_len; j += 256) {
        scores[j] = exp(scores[j] - max_val);
        local_sum += scores[j];
    }
    sdata[tid] = local_sum;
    barrier();

    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) sdata[tid] += sdata[tid + s];
        barrier();
    }
    float sum_val = sdata[0];
    barrier();

    // Normalize
    for (uint j = tid; j < seq_len; j += 256) {
        scores[j] /= sum_val;
    }
    barrier();

    // Phase 3: Weighted sum — output[row, head_offset + d] = sum_j scores[j] * V[j, head_offset + d]
    for (uint d = tid; d < head_dim; d += 256) {
        float val = 0.0;
        for (uint j = 0; j < seq_len; j++) {
            val += scores[j] * v[j * hidden + head_offset + d];
        }
        o[row * hidden + head_offset + d] = val;
    }
}
